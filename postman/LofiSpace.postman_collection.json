              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favorite\": true\n}"
            },
            "url": "{{baseUrl}}/api/soundtracks/{{soundtrackId}}"
          }
        },
        {
          "name": "Delete soundtrack",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/soundtracks/{{soundtrackId}}"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profile"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Little Dreamer\",\n  \"bio\": \"Making a little progress every day.\",\n  \"avatar\": \"🌙\"\n}"
            },
            "url": "{{baseUrl}}/api/profile"
          }
        }
      ]
    },
    {
      "name": "Focus sessions",
      "item": [
        {
          "name": "List focus sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/focus-sessions"
          }
        },
        {
          "name": "Get focus session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/focus-sessions/{{sessionId}}"
          }
        },
        {
          "name": "Create focus session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": 1,\n  \"duration_minutes\": 25,\n  \"started_at\": \"2026-11-23T09:00:00\",\n  \"ended_at\": \"2026-11-23T09:25:00\"\n}"
            },
            "url": "{{baseUrl}}/api/focus-sessions"
          }
        },
        {
